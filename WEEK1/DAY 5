--case statement

select customer_name,phone_no,address,
CASE address
when 'chennai' then 'madras'
when 'mumbai' then 'bombay'
else 'same'
end as previous_names
from customers

select age
from customers
order by age desc

--21-23 career age
--24-27 trip going age
--28-30 marriage age

select customer_name,age,
CASE 
when age between '21'and'23' then 'career age'
when age between '24'and'27' then 'trip going age'
when age between '28'and'30' then 'marriage age'
else 'study'
end as doings
from customers

select customer_name,address,
case address
when 'chennai' then 'madras'
when 'mumbai' then 'bombay'
when 'bangalore' then 'magalore'
when 'hyderabad' then 'pathabasti'
when 'delhi' then 'NewDelhi'
when 'vijaywada' then 'bejawada'
else 'same'
end as last_names
from customers
