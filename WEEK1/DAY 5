--view

  
create view test
as
select customer_name,
address,
order_id,
hotel_item,rating
from orders o
join customers c on o.customer_id=c.customer_id
join hotel_details h on o.hotel_id=h.hotel_id

select *
from test

alter view test
as
select customer_name,
address,
order_id,
hotel_item,partner_name,h.rating
from orders o
join customers c on o.customer_id=c.customer_id
join hotel_details h on o.hotel_id=h.hotel_id
join delivery d on o.partner_id=d.partner_id

create view short
as
select c.customer_id,customer_name,
phone_no,
order_id,
hotel_item,rating
from orders o
join customers c on o.customer_id=c.customer_id
join hotel_details h on o.hotel_id=h.hotel_id

drop view short

