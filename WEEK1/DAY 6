   Q.Find top-performing hotels where:
revenue > average hotel revenue
AND orders > average hotel orders
  
SELECT hotel_id,
       SUM(order_amount) AS revenue,
       COUNT(order_id) AS total_orders
FROM orders
GROUP BY hotel_id
HAVING SUM(order_amount) >
(
    SELECT AVG(revenue)
    FROM
    (
        SELECT SUM(order_amount) AS revenue
        FROM orders
        GROUP BY hotel_id
    ) x
)
AND COUNT(order_id) >
(
    SELECT AVG(total_orders)
    FROM
    (
        SELECT COUNT(order_id) AS total_orders
        FROM orders
        GROUP BY hotel_id
    ) y
);


