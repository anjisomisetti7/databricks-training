--CTE

with employees as
(    
    select emp_name,age,gender,
    salary + ISNULL(bonus,0) as total_salary 
    from employee e
    join infosys i on e.emp_id=i.emp_id
)

select
   emp_name,total_salary
   from employees
   order by total_salary desc

with seniors as
(
           select e.emp_id,emp_name,comp_role,
           salary + isnull(bonus,0) as total_salary
       
           from employee e
           join infosys i on e.emp_id=i.emp_id
),
 average_sal as
 (         
               select AVG(total_salary) as avg_sals
               from seniors
)

select seniors.emp_name,seniors.comp_role,seniors.total_salary
from seniors
where seniors.total_salary > (select avg_sals from average_sal)

with expert as
(
        select emp_name,comp_role,salary,expereince
        from employee e
        join infosys i on e.emp_id=i.emp_id
)

select emp_name,comp_role,salary,
       isnull(expereince,0) as experience
from expert

with senior as
(
        select emp_name,comp_role,salary,expereince
        from employee e
        join infosys i on e.emp_id=i.emp_id
        where expereince > 3
)

select *
from senior
      

with richEmployee as 
( 
      select emp_name,age,salary,bonus
      from employee e
      inner join infosys i on e.emp_id=i.emp_id
      where bonus is not null
)
 select *
 from richEmployee
 where salary > 50000

 WITH salary_cte AS (
    SELECT 
        e.emp_name,
        i.salary,
        i.bonus,
        (i.salary + ISNULL(i.bonus, 0)) AS total_salary
    FROM employee e
    JOIN infosys i ON e.emp_id = i.emp_id
),
filtered_cte AS (
    SELECT *
    FROM salary_cte
    WHERE total_salary > 50000
      AND bonus IS NOT NULL
)
SELECT *
FROM filtered_cte;

