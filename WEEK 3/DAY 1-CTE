with salary_cte AS (
    SELECT 
        e.emp_name,
        i.comp_role,
        (i.salary + ISNULL(i.bonus, 0)) AS total_salary
    FROM employee e
    JOIN infosys i ON e.emp_id = i.emp_id
),
rank_cte AS (
    SELECT *,
           ROW_NUMBER() OVER (PARTITION BY comp_role ORDER BY total_salary DESC) AS rn
    FROM salary_cte
)
SELECT *
FROM rank_cte
WHERE rn = 1;

with join_cte AS (
    SELECT 
        e.emp_name,
        i.date_of_joining
    FROM employee e
    JOIN infosys i ON e.emp_id = i.emp_id
)
SELECT *
FROM join_cte
WHERE date_of_joining > '2022-07-01';

with bonus_cte AS (
    SELECT 
        e.emp_name,
        i.salary,
        i.bonus,
        (ISNULL(i.bonus, 0) * 100.0 / i.salary) AS bonus_percent
    FROM employee e
    JOIN infosys i ON e.emp_id = i.emp_id
)
SELECT *
FROM bonus_cte;
