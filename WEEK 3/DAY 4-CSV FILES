schema manually
from pyspark.sql.types import *

schema = StructType([
    StructField("id", IntegerType(), True),
    StructField("name", StringType(), True),
    StructField("age", IntegerType(), True)
])

df = spark.read \
.schema(schema) \
.csv("/path/file.csv")

  for selecting columns
df.select("name","age").show()  
 
  Remove Duplicates
df.dropDuplicates()

  Write CSV File
df.write.csv("/output/path")

  Write CSV With Header
df.write \
.option("header","true") \
.csv("/output/path")

  Write Pipe CSV
df.write \
.option("header","true") \
.option("sep","|") \
.csv("/output/path")

  Overwrite Existing File
df.write \
.mode("overwrite") \
.csv("/output/path")

  Append Data
df.write \
.mode("append") \
.csv("/output/path")

  Read Corrupt Records
df = spark.read \
.option("mode","PERMISSIVE") \
.csv("/path/file.csv")

