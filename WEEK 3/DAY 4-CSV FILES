for multiline data
  
  df3=spark.read.csv("/Volumes/my_files/my_filesschema/csv_files/my_files/Pipe Single Quote Escape Multiline CSV - Copy.txt",
                   header= True,
                   sep="|",
                   inferSchema=True,
                   quote="'",
                   escape="#",
                   multiLine=True)
display(df3) 

from pyspark.sql.functions import regexp_replace,col

df_clean = df3.select(
    regexp_replace(col("id"), r"[\'\\\\]", "").alias("id"),
    regexp_replace(col("name"), r"[\'\\\\]", "").alias("name"),
    regexp_replace(col("age"), r"[\'\\\\]", "").alias("age"),
    regexp_replace(col("gender"), r"[\'\\\\]", "").alias("gender"),
    regexp_replace(col("email"), r"[\'\\\\n]", "").alias("email")
)

display(df_clean) 

  
  
